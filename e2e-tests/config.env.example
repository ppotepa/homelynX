# E2E Test Configuration (copy to config.env and fill in)

# Test HTTP endpoint (inject-update harness)
TEST_ENDPOINT="http://localhost:5000"
# Leave empty when the running bot has no secret configured; set to match .env for secured endpoint.
TEST_ENDPOINT_SECRET=""
TORRENTBOT_TEST_ENDPOINT_SECRET=""

# Telegram Bot (Production)
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TEST_CHAT_ID="your_telegram_user_id"

# qBittorrent
QBITTORRENT_URL="http://localhost:8080"
QBITTORRENT_USER="admin"
QBITTORRENT_PASS="adminadmin"

# Jackett
JACKETT_URL="http://localhost:9117"
JACKETT_API_KEY="your-jackett-api-key"

# Test Data
TEST_MEDIA_DIR="/path/to/mediaserver"
TEST_LARGE_FILE="${TEST_MEDIA_DIR}/test-large-file.iso"

# Timeouts
DEFAULT_TIMEOUT=5
RESPONSE_TIMEOUT=3

# Logging
LOG_LEVEL="INFO"
LOG_FILE="results/test-run.log"